{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "인프라에서 세팅한 Prometheus 데이터소스를 선택해서 임포트해주세요.",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Gateway 상태",
      "description": "Prometheus가 Gateway 관리 포트(9091)를 정상 수집하는지 표시합니다.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "expr": "max(up{instance=~\".*(gateway-service|9091).*\"}) or vector(0)", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "전체 요청 처리량",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"gateway-service\",uri!~\"/actuator.*\"}[1m]))", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "평균 응답시간",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 2000 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "1000 * sum(rate(http_server_requests_seconds_sum{application=\"gateway-service\",uri!~\"/actuator.*\"}[1m])) / clamp_mean(sum(rate(http_server_requests_seconds_count{application=\"gateway-service\",uri!~\"/actuator.*\"}[1m])), 0.001)", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "5xx 오류율",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"gateway-service\",status=~\"5..\"}[5m])) / clamp_mean(sum(rate(http_server_requests_seconds_count{application=\"gateway-service\"}[5m])), 0.001)", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "인증·인가 실패",
      "description": "최근 5분 동안 Gateway가 반환한 401과 403 건수입니다.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "sum(increase(http_server_requests_seconds_count{application=\"gateway-service\",status=~\"401|403\"}[5m]))", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Gateway HTTP 응답시간",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "ms", "mean": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "1000 * sum(rate(http_server_requests_seconds_sum{application=\"gateway-service\",uri!~\"/actuator.*\"}[1m])) / clamp_mean(sum(rate(http_server_requests_seconds_count{application=\"gateway-service\",uri!~\"/actuator.*\"}[1m])), 0.001)", "legendFormat": "평균", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "HTTP 상태코드별 요청량",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "mean": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"gateway-service\",uri!~\"/actuator.*\"}[1m]))", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "라우트별 처리량",
      "description": "Spring Cloud Gateway가 기록한 routeId별 초당 요청 수입니다.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps", "mean": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{application=\"gateway-service\"}[1m]))", "legendFormat": "{{routeId}}", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "title": "라우트별 평균 응답시간",
      "description": "Gateway 자체 지연과 하위 서비스 응답 지연이 합쳐진 routeId별 평균 시간입니다.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ms", "mean": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "1000 * sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_sum{application=\"gateway-service\"}[1m])) / clamp_mean(sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{application=\"gateway-service\"}[1m])), 0.001)", "legendFormat": "{{routeId}}", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "title": "Gateway 502·504 발생률",
      "description": "하위 서비스 연결 실패(502)와 응답 제한시간 초과(504)를 분리해 확인합니다.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "reqps", "mean": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"gateway-service\",status=~\"502|504\"}[1m]))", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "id": 11,
      "title": "라우트별 결과",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "reqps", "mean": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (routeId, outcome) (rate(spring_cloud_gateway_requests_seconds_count{application=\"gateway-service\"}[1m]))", "legendFormat": "{{routeId}} / {{outcome}}", "refId": "A" }
      ]
    },
    {
      "id": 12,
      "title": "CPU 사용률",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "percent", "mean": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "process_cpu_usage{application=\"gateway-service\"} * 100", "legendFormat": "프로세스", "refId": "A" },
        { "expr": "system_cpu_usage{application=\"gateway-service\"} * 100", "legendFormat": "시스템", "refId": "B" }
      ]
    },
    {
      "id": 13,
      "title": "JVM Heap 사용률",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "percent", "mean": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "100 * sum(jvm_memory_used_bytes{application=\"gateway-service\",area=\"heap\"}) / clamp_mean(sum(jvm_memory_max_bytes{application=\"gateway-service\",area=\"heap\"} >= 0), 1)", "legendFormat": "Heap", "refId": "A" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["money-town", "gateway-service", "performance"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {}
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MoneyTown Gateway Service Monitoring",
  "uid": "moneytown-gateway-service",
  "version": 1
}
