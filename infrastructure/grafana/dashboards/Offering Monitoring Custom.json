          "expr": "100 *\r\nsum by (method, uri) (\r\n  rate(\r\n    http_server_requests_seconds_count{\r\n      application=\"offering-service\",\r\n      uri=~\"/api/v1/.*\",\r\n      status=~\"2..\"\r\n    }[$__rate_interval]\r\n  )\r\n)\r\n/\r\nsum by (method, uri) (\r\n  rate(\r\n    http_server_requests_seconds_count{\r\n      application=\"offering-service\",\r\n      uri=~\"/api/v1/.*\"\r\n    }[$__rate_interval]\r\n  )\r\n)",
