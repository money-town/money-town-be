{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "인프라에서 세팅한 Prometheus 데이터소스를 선택해서 임포트해주세요.",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "User Service 상태",
      "description": "Prometheus가 User Service 메트릭 엔드포인트를 정상 수집하는지 표시합니다.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "expr": "max(up{instance=~\".*(user-service|19092).*\"}) or vector(0)", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "요청 처리량",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"user-service\",uri!~\"/actuator.*\"}[1m]))", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "로그인 p95 응답시간",
      "description": "로그인 요청의 95%가 이 시간 안에 완료됩니다. HTTP histogram 설정이 필요합니다.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 1000 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"user-service\",uri=\"/api/v1/auth/login\"}[5m])))", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "5xx 오류율",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"user-service\",status=~\"5..\"}[5m])) / clamp_mean(sum(rate(http_server_requests_seconds_count{application=\"user-service\"}[5m])), 0.001)", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "DB 풀 사용률",
      "description": "HikariCP 최대 연결 수 대비 현재 사용 중인 연결 비율입니다.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "100 * sum(hikaricp_connections_active{application=\"user-service\"}) / clamp_mean(sum(hikaricp_connections_max{application=\"user-service\"}), 1)", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "전체 HTTP 응답시간",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "1000 * sum(rate(http_server_requests_seconds_sum{application=\"user-service\",uri!~\"/actuator.*\"}[1m])) / clamp_mean(sum(rate(http_server_requests_seconds_count{application=\"user-service\",uri!~\"/actuator.*\"}[1m])), 0.001)", "legendFormat": "평균", "refId": "A" },
        { "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"user-service\",uri!~\"/actuator.*\"}[5m])))", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "id": 7,
      "title": "HTTP 상태코드별 요청량",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"user-service\",uri!~\"/actuator.*\"}[1m]))", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "핵심 API 평균 응답시간",
      "description": "로그인, 내부 투자 적격 조회, KYC 요청의 URI별 평균 응답시간입니다.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "1000 * sum by (uri) (rate(http_server_requests_seconds_sum{application=\"user-service\",uri=~\"/api/v1/(auth/login|internal/users/.*|kyc-verifications.*)\"}[1m])) / clamp_mean(sum by (uri) (rate(http_server_requests_seconds_count{application=\"user-service\",uri=~\"/api/v1/(auth/login|internal/users/.*|kyc-verifications.*)\"}[1m])), 0.001)", "legendFormat": "{{uri}}", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "title": "핵심 API 처리량",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"user-service\",uri=~\"/api/v1/(auth/login|internal/users/.*|kyc-verifications.*)\"}[1m]))", "legendFormat": "{{uri}}", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "title": "HikariCP 연결 상태",
      "description": "대기(pending)가 지속되면 DB 연결 풀 포화 가능성이 있습니다.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "short", "mean": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum(hikaricp_connections_active{application=\"user-service\"})", "legendFormat": "사용 중", "refId": "A" },
        { "expr": "sum(hikaricp_connections_idle{application=\"user-service\"})", "legendFormat": "유효", "refId": "B" },
        { "expr": "sum(hikaricp_connections_pending{application=\"user-service\"})", "legendFormat": "대기", "refId": "C" },
        { "expr": "sum(hikaricp_connections_max{application=\"user-service\"})", "legendFormat": "최대", "refId": "D" }
      ]
    },
    {
      "id": 11,
      "title": "DB 연결 획득 시간",
      "description": "커넥션 풀에서 DB 연결을 빌리는 데 걸린 평균 시간입니다.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "ms", "mean": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "1000 * sum(rate(hikaricp_connections_acquire_seconds_sum{application=\"user-service\"}[1m])) / clamp_mean(sum(rate(hikaricp_connections_acquire_seconds_count{application=\"user-service\"}[1m])), 0.001)", "legendFormat": "평균 획득시간", "refId": "A" }
      ]
    },
    {
      "id": 12,
      "title": "CPU 사용률",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "percent", "mean": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "process_cpu_usage{application=\"user-service\"} * 100", "legendFormat": "프로세스", "refId": "A" },
        { "expr": "system_cpu_usage{application=\"user-service\"} * 100", "legendFormat": "시스템", "refId": "B" }
      ]
    },
    {
      "id": 13,
      "title": "JVM Heap 사용률",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "percent", "mean": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "100 * sum(jvm_memory_used_bytes{application=\"user-service\",area=\"heap\"}) / clamp_mean(sum(jvm_memory_max_bytes{application=\"user-service\",area=\"heap\"} >= 0), 1)", "legendFormat": "Heap", "refId": "A" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["money-town", "user-service", "performance"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {}
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MoneyTown User Service Monitoring",
  "uid": "moneytown-user-service",
  "version": 1
}
