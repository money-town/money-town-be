{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "인프라에서 세팅한 Prometheus 데이터소스를 선택해서 임포트해주세요.",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "서비스 공통 모니터링",
  "uid": "services-overview-ko",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "tags": ["money-town", "overview"],
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "서비스",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(jvm_memory_used_bytes, application)",
        "query": "label_values(jvm_memory_used_bytes, application)",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "요청 처리량 (초당)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\"}[1m]))", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "평균 응답시간 (ms)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 300 },
            { "color": "red", "value": 1000 }
          ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "1000 * sum(rate(http_server_requests_seconds_sum{application=\"$application\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"$application\"}[1m]))", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "에러율 5xx (%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"$application\"}[1m]))", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "힙 메모리 사용률 (%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 90 }
          ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        { "expr": "100 * sum(jvm_memory_used_bytes{application=\"$application\", area=\"heap\"}) / sum(jvm_memory_max_bytes{application=\"$application\", area=\"heap\"} >= 0)", "refId": "A" }
      ]
    },

    {
      "id": 10,
      "title": "처리량 — 초당 요청 수",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "description": "http_server_requests 카운터의 1분 증가율. 트래픽이 없으면 0.",
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\"}[1m]))", "legendFormat": "전체", "refId": "A" }
      ]
    },
    {
      "id": 11,
      "title": "응답시간 — 평균 (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "description": "요청 처리 총시간 / 요청 수. 꼬리 지연은 안 보이므로 참고용.",
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "1000 * sum(rate(http_server_requests_seconds_sum{application=\"$application\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"$application\"}[1m]))", "legendFormat": "평균", "refId": "A" }
      ]
    },

    {
      "id": 12,
      "title": "상태코드별 요청 수 (초당)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"$application\"}[1m]))", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "id": 13,
      "title": "에러율 (%) — 4xx / 5xx",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"4..\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"$application\"}[1m]))", "legendFormat": "4xx", "refId": "A" },
        { "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"$application\"}[1m]))", "legendFormat": "5xx", "refId": "B" }
      ]
    },

    {
      "id": 14,
      "title": "URI별 처리량 상위 10 (초당)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "description": "uri 는 템플릿 경로(예: /api/v1/users/{id})로 집계된다.",
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{application=\"$application\"}[5m])))", "legendFormat": "{{uri}}", "refId": "A" }
      ]
    },
    {
      "id": 15,
      "title": "URI별 평균 응답시간 (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "1000 * sum by (uri) (rate(http_server_requests_seconds_sum{application=\"$application\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{application=\"$application\"}[5m]))", "legendFormat": "{{uri}}", "refId": "A" }
      ]
    },

    {
      "id": 16,
      "title": "CPU 사용률 (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "description": "프로세스 = 이 JVM, 시스템 = 컨테이너/호스트 전체. (컨테이너 RSS 아님)",
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "process_cpu_usage{application=\"$application\"} * 100", "legendFormat": "프로세스", "refId": "A" },
        { "expr": "system_cpu_usage{application=\"$application\"} * 100", "legendFormat": "시스템", "refId": "B" }
      ]
    },
    {
      "id": 17,
      "title": "힙 메모리",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{application=\"$application\", area=\"heap\"})", "legendFormat": "사용", "refId": "A" },
        { "expr": "sum(jvm_memory_max_bytes{application=\"$application\", area=\"heap\"} >= 0)", "legendFormat": "최대", "refId": "B" }
      ]
    },

    {
      "id": 18,
      "title": "논힙 메모리 (Metaspace 등)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{application=\"$application\", area=\"nonheap\"})", "legendFormat": "사용", "refId": "A" }
      ]
    },
    {
      "id": 19,
      "title": "GC — 소요시간 / 횟수",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "description": "소요시간(초/초)이 계속 높으면 GC가 병목.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(jvm_gc_pause_seconds_sum{application=\"$application\"}[1m]))", "legendFormat": "소요시간(초/초)", "refId": "A" },
        { "expr": "sum(rate(jvm_gc_pause_seconds_count{application=\"$application\"}[1m]))", "legendFormat": "횟수(회/초)", "refId": "B" }
      ]
    },

    {
      "id": 20,
      "title": "스레드 수",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "jvm_threads_live_threads{application=\"$application\"}", "legendFormat": "활성", "refId": "A" },
        { "expr": "jvm_threads_daemon_threads{application=\"$application\"}", "legendFormat": "데몬", "refId": "B" },
        { "expr": "jvm_threads_peak_threads{application=\"$application\"}", "legendFormat": "최대(peak)", "refId": "C" }
      ]
    },
    {
      "id": 21,
      "title": "DB 커넥션 풀 (HikariCP)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "description": "DB를 쓰지 않는 서비스(discovery-server, config-server, gateway-service)는 값이 없다. 대기(pending)가 0보다 크면 풀 고갈.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(hikaricp_connections_active{application=\"$application\"})", "legendFormat": "활성", "refId": "A" },
        { "expr": "sum(hikaricp_connections_idle{application=\"$application\"})", "legendFormat": "유휴", "refId": "B" },
        { "expr": "sum(hikaricp_connections_pending{application=\"$application\"})", "legendFormat": "대기", "refId": "C" },
        { "expr": "sum(hikaricp_connections_max{application=\"$application\"})", "legendFormat": "최대", "refId": "D" }
      ]
    }
  ]
}
