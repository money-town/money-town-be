
POSTGRES_USER=moneytown
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me
REDIS_HOST_PORT=6379
REDISINSIGHT_HOST_PORT=8001

ZIPKIN_HOST_PORT=9411
TRACING_SAMPLING_PROBABILITY=1.0
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# 모니터링
# HOST_PORT 는 로컬(base)에서만 의미 있음. prod 오버레이는 루프백에만 바인딩한다.
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me
# prod 에서 nginx 가 서브패스로 프록시할 때의 외부 주소 (끝 슬래시 포함). 로컬은 불필요.
GRAFANA_ROOT_URL=https://www.moneytown.shop/grafana/

NGINX_HOST_PORT=8002

SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGIN_PATTERN=http://localhost:*

JVM_MAX_RAM_PERCENTAGE=65

JWT_SECRET=bW9uZXktdG93bi1jaS1qd3Qtc2VjcmV0LWtleS1taW5pbXVtLTMyLWJ5dGVz
JWT_ISSUER=money-town-user-service

SLACK_WEBHOOK_URL=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=moneytown-asset

OPENAI_API_KEY=
# offering-service - Subscription
SUBSCRIPTION_RESERVATION_TIMEOUT_MINUTES=10

# offering-service - Outbox
# 한 번의 스케줄 실행에서 선점하여 발행할 최대 이벤트 수
OUTBOX_PUBLISH_BATCH_SIZE = 10

# ========================================
# 운영 환경 서비스 리소스 및 복제 설정
# docker-compose.prod.yml에서 사용한다.
# 값을 설정하지 않으면 아래와 동일한 기본값이 적용된다.
# 단일 EC2에서 복제 수만 늘려도 실제 CPU 용량은 증가하지 않는다.
# ========================================

# Gateway 컨테이너 복제 수
GATEWAY_REPLICAS=1

# User Service 컨테이너가 사용할 수 있는 최대 CPU 수
# CPU를 추가로 할당하는 값이 아니라 기존 EC2 CPU의 사용 상한이다.
USER_SERVICE_CPUS=2.0

# User Service 컨테이너 복제 수
USER_SERVICE_REPLICAS=1
# SETTLEMENT_REVENUE_POLLING_ENABLED=false
